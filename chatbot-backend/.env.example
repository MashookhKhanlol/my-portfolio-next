# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL — can reuse Strapi's DB or use a separate one
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot_pass@postgres:5432/chatbot

# Redis — for session management
REDIS_URL=redis://redis:6379/0

# ── Optional ──────────────────────────────────────────────────────────────────
# Admin API key — protect /admin/* endpoints
ADMIN_API_KEY=changeme-set-a-strong-key

# Strapi token — needed for live data lane
STRAPI_TOKEN=your_strapi_api_token_here

# CORS — comma-separated origins allowed to use the chatbot API
# Use * for development, restrict to your domain in production
CORS_ORIGINS=https://portfolio.flowcrafted.me,https://strapi.flowcrafted.me

# Environment
ENVIRONMENT=production
