# ── Strapi CMS (self-hosted) ──────────────────────────────────────────────────
# Your Strapi instance URL. Set this to activate Strapi as the content source.
# Local dev:  http://localhost:1337
# Production: https://strapi.yourdomain.com
NEXT_PUBLIC_STRAPI_URL=https://strapi.yourdomain.com

# ── ISR Revalidation secret ───────────────────────────────────────────────────
# Used by the /api/revalidate endpoint and Strapi webhook header.
# Must match the x-revalidate-secret header set in Strapi webhook config.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=your_random_secret_here

# ── Legacy remote data.json (optional fallback) ───────────────────────────────
# NEXT_PUBLIC_DATA_URL=https://raw.githubusercontent.com/YOUR_USERNAME/YOUR_REPO/main/data.json

# ── Gmail SMTP for contact form (Nodemailer) ──────────────────────────────────
# Use any Gmail account to SEND emails — messages will always arrive at mashookhkhan7862@gmail.com
# GMAIL_USER = the Gmail address you use to send (can be any Gmail you own)
# GMAIL_APP_PASSWORD = 16-character App Password (NOT your normal Gmail password)
# To generate: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
