
# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337

# ── Secrets ───────────────────────────────────────────────────────────────────
# Generate fresh values with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# APP_KEYS requires 4 comma-separated base64 values
APP_KEYS=key1_base64,key2_base64,key3_base64,key4_base64
API_TOKEN_SALT=generate_me
ADMIN_JWT_SECRET=generate_me
JWT_SECRET=generate_me
TRANSFER_TOKEN_SALT=generate_me
ENCRYPTION_KEY=generate_me

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Local dev:  DATABASE_HOST=127.0.0.1
# VPS Docker: DATABASE_HOST=postgres   (matches docker-compose service name)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_SSL=false
DATABASE_FILENAME=

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Required for image uploads. Get from: https://console.cloudinary.com
# Dashboard → Settings → API Keys
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret
